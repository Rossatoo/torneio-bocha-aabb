---
import { tournament } from '../data/tournament';
---

<section class="section bg-white">
  <div class="container-site">

    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-wider text-aabb-600">
        Participantes
      </p>

      <h1 class="section-title mt-2">
        Equipes
      </h1>

      <p class="section-subtitle mt-3">
        Conheça os trios que participam do Torneio de Inauguração da Cancha AABB-JC.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tournament.trios.map((trio, index) => (
          <article class="card overflow-hidden">

            <div class="border-b border-slate-100 bg-aabb-50 px-6 py-5">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-aabb-600">
                    Equipe {index + 1}
                  </p>

                  <h2 class="mt-1 text-lg font-bold text-aabb-900">
                    {trio.name}
                  </h2>
                </div>

                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-aabb-600 text-sm font-bold text-white">
                  {index + 1}
                </div>
              </div>
            </div>

            <div class="px-6 py-5">
              <p class="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                Jogadores
              </p>

              <ul class="space-y-3">
                {
                  trio.players.map((player) => (
                    <li class="flex items-center gap-3 text-sm font-medium text-slate-700">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs">
                        👤
                      </span>
                      {player}
                    </li>
                  ))
                }
              </ul>
            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>