---
import { times } from '../data/torneio';
---

<section id="equipes" class="bg-[#08130f]">
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.25em] text-[#d7ff45]">Participantes</p>
        <h2 class="mt-3 font-display text-4xl font-bold uppercase text-white sm:text-5xl">Equipes inscritas</h2>
      </div>
      <div class="font-display text-2xl font-semibold uppercase text-white/30">12 trios</div>
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {times.map((time, index) => (
        <article class="group flex min-h-[92px] items-center gap-4 rounded-2xl border border-white/10 bg-white/[.025] p-4 transition hover:-translate-y-0.5 hover:border-[#d7ff45]/30 hover:bg-white/[.045]">
          <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-white/5 font-display text-lg font-bold text-[#d7ff45]">
            {String(index + 1).padStart(2, '0')}
          </div>
          <h3 class="font-semibold leading-5 text-white/85 group-hover:text-white">{time}</h3>
        </article>
      ))}
    </div>
  </div>
</section>
