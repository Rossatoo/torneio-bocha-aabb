---
import { tournament } from '../data/tournament';
---

<section id="resultados" class="section bg-slate-50">

  <div class="container-site">

    <div class="text-center">

      <p class="text-sm font-bold uppercase tracking-wider text-aabb-600">
        Resultados
      </p>

      <h2 class="section-title mt-2">
        Últimas partidas
      </h2>

      <p class="section-subtitle mx-auto max-w-xl">
        Confira os resultados mais recentes do torneio.
      </p>

    </div>

    <div class="mx-auto mt-8 max-w-3xl space-y-4">

      {
        tournament.results.map((game) => (
          <article class="card p-5">

            <div class="mb-4 flex items-center justify-between text-xs font-semibold text-slate-400">

              <span>
                {game.phase}
              </span>

              <span>
                {game.venueShort}
              </span>

            </div>

            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4">

              <div class="text-right">

                <p class="font-bold text-aabb-800">
                  {game.trioA.name}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  {game.trioA.players.join(' · ')}
                </p>

              </div>

              <div class="rounded-md bg-aabb-50 px-4 py-2 text-xl font-bold text-aabb-800">

                {game.scoreA}

                <span class="mx-1 text-slate-300">
                  ×
                </span>

                {game.scoreB}

              </div>

              <div>

                <p class="font-bold text-aabb-800">
                  {game.trioB.name}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  {game.trioB.players.join(' · ')}
                </p>

              </div>

            </div>

          </article>
        ))
      }

    </div>

  </div>

</section>